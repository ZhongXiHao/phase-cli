{
  "name": "svg-editor",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "cli": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run deps && npm test",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.ts --coverage.exclude=src/main.ts"
  },
  "description": "SVG editor (CLI)",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
